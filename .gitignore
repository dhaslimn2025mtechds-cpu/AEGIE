# ============================================================
# AEGIE - Git Ignore Rules
# Final no-participant research prototype
# ============================================================

# Python cache / compiled files
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
aegie_env/
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
*.key
*.pem

# IDE / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs / temporary files
*.log
*.tmp
*.temp

